<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.java.runtimers.quizaiproject.controller.ForgotPasswordController"
            prefHeight="400.0" prefWidth="600.0">
    <children>

        <TextField  fx:id="emailField" layoutX="11.0" layoutY="180" prefHeight="51.0" prefWidth="340.0" promptText="Email">
            <font>
                <Font size="22.0" />
            </font>
            <AnchorPane.leftAnchor>10</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>10</AnchorPane.rightAnchor>
        </TextField>

        <Button alignment="CENTER" layoutX="69.0" layoutY="270" fx:id="requestPasswordButton"
                onAction="#onRequestPasswordButtonClick" prefHeight="36.0" prefWidth="222.0"
                style="-fx-background-radius: 200;" styleClass="custom_Button"
                stylesheets="@stylesheet.css" text="Request Password Change">
            <font>
                <Font size="22.0" />
            </font>
            <AnchorPane.leftAnchor>10</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>10</AnchorPane.rightAnchor>
        </Button>

        <Button id="hadAccount" alignment="CENTER" layoutX="82.0" layoutY="320.0" mnemonicParsing="false"
                onAction="#onReturnToLogin" prefHeight="34.0" prefWidth="197.0" stylesheets="@stylesheet.css"
                text="Return to Login Page"  textAlignment="CENTER">
            <AnchorPane.leftAnchor>10</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>10</AnchorPane.rightAnchor>
        </Button>

        <Label alignment="CENTER" layoutX="11.0" layoutY="10.0" prefHeight="100" prefWidth="340" text="Forgot your password?" textAlignment="CENTER">
            <font>
                <Font size="26.0" />
            </font>
            <AnchorPane.leftAnchor>10</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>10</AnchorPane.rightAnchor>
        </Label>

        <Label alignment="CENTER" text="Please enter the email address you'd like your password reset information sent to " textAlignment="LEFT" wrapText="true"
               AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="110.0">
            <font>
                <Font size="16.0" />
            </font>
        </Label>



    </children>
</AnchorPane>
